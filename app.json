{
  "expo": {
    "name": "Tu Viaje Operador",
    "slug": "Tu-Viaje-Operador",
    "version": "5.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tuviajeoperador",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splashe.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tuviajeoperador",
      "config": {
        "googleMapsApiKey": "AIzaSyCL2-TDfkLj4BHxjICT211r8PVx5AGuAzc"
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Esta aplicación necesita acceso a tu ubicación para mostrar tu posición en el mapa.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Esta aplicación necesita acceso a tu ubicación para navegación en tiempo real."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/splashe.png",
        "backgroundColor": "#000000"
      },
      "package": "com.tuviajeoperador",
      "versionCode": 25,
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyCL2-TDfkLj4BHxjICT211r8PVx5AGuAzc"
        }
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/icon.png"
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}